# ============ TOPSTEP 100K — SCALP MOMENTUM (MNQ) ============
# Bot bắt nến 5M đang chạy nhanh, vào theo hướng nến, chốt 10-50 điểm tuỳ độ mạnh.
# Điền 2 dòng <...> rồi lưu.

BOT_BROKER=topstep
TOPSTEP_USERNAME=<ten dang nhap TopstepX>
TOPSTEP_API_KEY=<API key>
TOPSTEP_ACCOUNT=
TOPSTEP_API_URL=https://api.topstepx.com
# Lệnh vào kèm cặp OCO (SL + TP) — bật Auto-OCO trong TopstepX. Bot tự dời SL/giảm khối lượng OCO.
TOPSTEP_OCO=true

BOT_STRATEGY=momentum
BOT_SYMBOL=MNQ
BOT_CONFIRM_SYMBOL=MES
BOT_POINT_VALUE=2
BOT_SIZE_DECIMALS=0
# 100K cho tối đa 100 micro TỔNG CỘNG: chạy cùng bot GC thì chia 50/50
BOT_MAX_CONTRACTS=50

# Rủi ro nhỏ hơn bot SMC vì scalp vào nhiều lệnh hơn
BOT_RISK_USD=150
# 0 = không dừng theo số R lỗ trong ngày (vẫn có chặn mức thua tối đa Topstep bên dưới)
BOT_MAX_DAILY_LOSS_R=0
# 0 = không giới hạn số lệnh/ngày
BOT_MAX_TRADES_PER_DAY=0

BOT_ACCOUNT_SIZE=100000
BOT_PROP_MAX_LOSS_USD=3000
BOT_PROP_TRAILING=eod
BOT_PROP_DAILY_LOSS_PCT=0
BOT_PROP_DAILY_LOSS_USD=
BOT_PROP_SAFETY=0.75
BOT_PROFIT_TARGET_USD=6000
BOT_FLATTEN_TIME_CT=15:08
BOT_DAY_RESET=cme

# Scalp cần kiểm tra giá thường xuyên (giây)
BOT_POLL_SECONDS=5
BOT_STATE_FILE=bot_state_momo_MNQ.json
BOT_DRY_RUN=true

# (Tuỳ chọn) nhắn Telegram mỗi khi vào/chốt/thoát lệnh. Để trống = không nhắn.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Kiểu vào lệnh (có thể ghép nhiều kiểu, cách nhau dấu phẩy; kiểu nào có tín hiệu trước thì vào):
#   rejection = nến 1M rút râu tại vùng nhiều volume, giá bật nhanh >= MOMO_FAST_MOVE điểm  (tốt nhất khi test)
#   close     = chờ nến 5M bung mạnh đóng cửa, vào nếu giá chưa hồi quá 30%
#   fomo | pullback | breakout = các kiểu khác (kém hơn khi test)
MOMO_ENTRY_MODE=rejection,close
# Vùng volume: profile 1M trong 240 phút (4 giờ), mỗi ô 5 điểm, lấy top 20% ô nhiều volume nhất
MOMO_VP_LOOKBACK=240
# MOMO_VP_BIN=5
# MOMO_ZONE_W=4             # râu phải chạm cách vùng tối đa 4 điểm
# MOMO_WICK_RATIO=0.5       # râu >= 50% cây nến 1M
# MOMO_FAST_MOVE=6          # giá bật >= 6 điểm khỏi đáy râu mới vào
# Lọc volume (khi test NQ không giúp, để 0):
# MOMO_VOL_MULT=0           # nến rút râu phải có volume >= x lần trung bình
# MOMO_BOUNCE_VOL_MULT=0    # các nến bật sau râu phải có volume >= x lần trung bình
# MOMO_ACTIVE_VOL_MULT=0    # 30 phút gần nhất phải có volume >= x lần trung bình ...
# MOMO_ACTIVE_VOL_BASE=0    # ... của N phút gần nhất (0 = bằng MOMO_VP_LOOKBACK, 1440 = 24 giờ)
# Thay lọc giờ bằng lọc volume: để trống MOMO_SESSIONS, đặt MOMO_ACTIVE_VOL_MULT=0.8 và
# MOMO_ACTIVE_VOL_BASE=1440 (khi test: +27R, gần bằng lọc giờ +38R; tự bỏ phiên Á vì volume thấp)
# Chỉ mở lệnh trong giờ UTC này: 7-20 = London + New York (7:00 sáng - 20:00 UTC,
# tức 14:00 chiều - 3:00 sáng giờ VN). Phiên Á làm momentum lỗ đều khi test.
MOMO_SESSIONS=7-20
# 1 = chỉ vào cùng chiều EMA20 khung 15M (ít lệnh hơn)
# Không vào lệnh (và đóng lệnh đang mở) trong các khung giờ New York này: 08:28-08:40 là giờ
# ra tin Mỹ (NFP, CPI... lúc 8:30 sáng New York). Thêm giờ mở cửa: 08:28-08:40,09:28-09:35
MOMO_BLACKOUT=08:28-08:40
MOMO_TREND_FILTER=0
# Số lệnh tối đa trong cùng 1 nến 5M: 0 = không giới hạn
MOMO_MAX_PER_CANDLE=0

# NQ dùng ngưỡng mặc định (điểm NQ). Bỏ dấu # để chỉnh:
# MOMO_MIN_5M_MOVE=15        # nến 5M phải chạy ít nhất 15 điểm
# MOMO_MIN_ATR_MULT=0.8      # và ít nhất 0.8 x ATR(5M); thử 1.2 = chỉ bắt nến rất mạnh
# MOMO_MIN_1M_MOVE=8         # 2 nến 1M gần nhất cùng đẩy ít nhất 8 điểm
# MOMO_MIN_TP=10             # mục tiêu từ 10 ...
# MOMO_MAX_TP=50             # ... đến 50 điểm tuỳ độ mạnh
# MOMO_SCALP_TP=10           # chốt 1/2 ở +10, dời SL về hoà vốn
# MOMO_MIN_SL=6
# MOMO_MAX_SL=20             # SL cần xa hơn 20 điểm = vào quá trễ, bỏ qua
# MOMO_TRAIL=8               # phần còn lại trail cách giá tốt nhất 8 điểm
# MOMO_FADE_BODY=6           # nến 1M ngược >= 6 điểm = hết momentum, thoát
# MOMO_MAX_HOLD_MIN=15       # giữ tối đa 15 phút
# MOMO_TICK=0.25
