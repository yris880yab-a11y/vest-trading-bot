# prod | dev
VEST_ENV=prod

# Lấy từ `python scripts/register.py` — KHÔNG commit file .env
VEST_API_KEY=
VEST_ACCOUNT_GROUP=
VEST_SIGNING_PRIVATE_KEY=

# Chiến lược: smc (sweep → MSS → retest, đa khung) | ema (EMA crossover cũ)
BOT_STRATEGY=smc
BOT_SYMBOL=BTC-PERP
# Mã dùng để xác nhận thị trường (vd ES khi trade NQ). Bỏ trống = không chấm điểm này
BOT_CONFIRM_SYMBOL=
# Điểm momentum tối thiểu để vào lệnh (3 = VALID)
BOT_MIN_MOMENTUM=3
# Số chữ số thập phân của khối lượng (để chia lệnh khi chốt từng phần)
BOT_SIZE_DECIMALS=4
# Giới hạn rủi ro mỗi ngày (phiên CME bắt đầu 22:00 UTC)
BOT_MAX_DAILY_LOSS_R=3
BOT_MAX_TRADES_PER_DAY=6
# File lưu lệnh đang mở để bot khởi động lại không mất SL/TP
BOT_STATE_FILE=bot_state.json

# Chỉ dùng cho BOT_STRATEGY=ema
BOT_INTERVAL=15m
BOT_FAST_EMA=9
BOT_SLOW_EMA=21
BOT_ORDER_SIZE=0.001
BOT_LEVERAGE=2
BOT_STOP_LOSS_PCT=1.5
BOT_TAKE_PROFIT_PCT=3.0
BOT_MAX_SLIPPAGE_PCT=0.5
BOT_POLL_SECONDS=30

# true = chỉ log, không đặt lệnh thật. Đổi thành false khi đã chắc chắn.
BOT_DRY_RUN=true
