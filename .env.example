# prod | dev
VEST_ENV=prod

# Lấy từ `python scripts/register.py` — KHÔNG commit file .env
VEST_API_KEY=
VEST_ACCOUNT_GROUP=
VEST_SIGNING_PRIVATE_KEY=

# Chiến lược
BOT_SYMBOL=BTC-PERP
BOT_INTERVAL=15m
BOT_FAST_EMA=9
BOT_SLOW_EMA=21
BOT_ORDER_SIZE=0.001
BOT_LEVERAGE=2
BOT_STOP_LOSS_PCT=1.5
BOT_TAKE_PROFIT_PCT=3.0
BOT_MAX_SLIPPAGE_PCT=0.5
BOT_POLL_SECONDS=30

# true = chỉ log, không đặt lệnh thật. Đổi thành false khi đã chắc chắn.
BOT_DRY_RUN=true
