# prod | dev
VEST_ENV=prod

# Lấy từ `python scripts/register.py` — KHÔNG commit file .env
VEST_API_KEY=
VEST_ACCOUNT_GROUP=
VEST_SIGNING_PRIVATE_KEY=

# Chiến lược: smc (sweep → MSS → retest, đa khung) | ema (EMA crossover cũ)
BOT_STRATEGY=smc
BOT_SYMBOL=BTC-PERP
# Mã dùng để xác nhận thị trường (vd ES khi trade NQ). Bỏ trống = không chấm điểm này
BOT_CONFIRM_SYMBOL=
# Điểm momentum tối thiểu để vào lệnh (3 = VALID)
BOT_MIN_MOMENTUM=3
# Số chữ số thập phân của khối lượng (để chia lệnh khi chốt từng phần)
BOT_SIZE_DECIMALS=4
# Rủi ro mỗi lệnh tính bằng USD: bot tự tính khối lượng để chạm SL = mất đúng số này (= 1R).
# Bỏ trống thì dùng khối lượng cố định BOT_ORDER_SIZE. Gợi ý: 0.5–1% vốn tài khoản.
BOT_RISK_USD=
# Trần giá trị vị thế (USD) để SL quá gần không tạo ra lệnh quá to. Bỏ trống = không giới hạn.
BOT_MAX_NOTIONAL_USD=
# Ngày giao dịch reset lúc: vest = 8:00 PM giờ New York (giống Vest Capital), cme = 22:00 UTC
BOT_DAY_RESET=vest
# Giới hạn rủi ro mỗi ngày
BOT_MAX_DAILY_LOSS_R=3
BOT_MAX_TRADES_PER_DAY=6
# File lưu lệnh đang mở để bot khởi động lại không mất SL/TP
BOT_STATE_FILE=bot_state.json

# Chỉ dùng cho BOT_STRATEGY=ema
BOT_INTERVAL=15m
BOT_FAST_EMA=9
BOT_SLOW_EMA=21
BOT_ORDER_SIZE=0.001
BOT_LEVERAGE=10
BOT_STOP_LOSS_PCT=1.5
BOT_TAKE_PROFIT_PCT=3.0
BOT_MAX_SLIPPAGE_PCT=0.5
BOT_POLL_SECONDS=30

# true = chỉ log, không đặt lệnh thật. Đổi thành false khi đã chắc chắn.
BOT_DRY_RUN=true

# ---- Tài khoản funded / evaluation (Vest Capital). Bỏ trống BOT_ACCOUNT_SIZE nếu dùng tiền riêng.
# Vest Capital KHÔNG cho dùng bot: khi đặt BOT_ACCOUNT_SIZE phải giữ BOT_DRY_RUN=true + Telegram.
# Cỡ tài khoản ban đầu: 5000 / 10000 / 25000
BOT_ACCOUNT_SIZE=
# Luật quỹ: lỗ ngày tối đa 4% số dư lúc reset, sàn drawdown tĩnh 6% dưới số dư ban đầu
BOT_PROP_DAILY_LOSS_PCT=4
BOT_PROP_MAX_DD_PCT=6
# Bot chỉ dùng 75% giới hạn của quỹ, phần còn lại là biên an toàn cho trượt giá
BOT_PROP_SAFETY=0.75
# Evaluation: đạt mục tiêu (10% = 500 / 1000 / 2500) thì bot ngừng. Funded: bỏ trống.
BOT_PROFIT_TARGET_USD=

# ---- Báo lệnh qua Telegram (dùng khi không được chạy bot qua API: bot báo, bạn tự bấm lệnh)
# Tạo bot với @BotFather để lấy token; nhắn cho bot 1 tin rồi mở
# https://api.telegram.org/bot<TOKEN>/getUpdates để lấy chat id. Giữ BOT_DRY_RUN=true.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
