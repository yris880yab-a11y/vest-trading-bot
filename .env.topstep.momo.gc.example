# ============ TOPSTEP — SCALP MOMENTUM (MGC) ============
# Bot bắt nến 5M đang chạy nhanh, vào theo hướng nến, chốt 10-50 điểm tuỳ độ mạnh.
# Điền 2 dòng <...> rồi lưu.

BOT_BROKER=topstep
TOPSTEP_USERNAME=<ten dang nhap TopstepX>
TOPSTEP_API_KEY=<API key>
TOPSTEP_ACCOUNT=
TOPSTEP_API_URL=https://api.topstepx.com

BOT_STRATEGY=momentum
BOT_SYMBOL=MGC
BOT_CONFIRM_SYMBOL=
BOT_POINT_VALUE=10
BOT_SIZE_DECIMALS=0
BOT_MAX_CONTRACTS=25

# Rủi ro nhỏ hơn bot SMC vì scalp vào nhiều lệnh hơn
BOT_RISK_USD=100
BOT_MAX_DAILY_LOSS_R=3
BOT_MAX_TRADES_PER_DAY=15

BOT_ACCOUNT_SIZE=50000
BOT_PROP_MAX_LOSS_USD=2000
BOT_PROP_TRAILING=eod
BOT_PROP_DAILY_LOSS_PCT=0
BOT_PROP_DAILY_LOSS_USD=
BOT_PROP_SAFETY=0.75
BOT_PROFIT_TARGET_USD=3000
BOT_FLATTEN_TIME_CT=15:08
BOT_DAY_RESET=cme

# Scalp cần kiểm tra giá thường xuyên (giây)
BOT_POLL_SECONDS=5
BOT_STATE_FILE=bot_state_momo_MGC.json
BOT_DRY_RUN=true

# (Tuỳ chọn) nhắn Telegram mỗi khi vào/chốt/thoát lệnh. Để trống = không nhắn.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Kiểu vào lệnh: nến 1M rút râu tại vùng nhiều volume (rejection). Vàng BẮT BUỘC lọc volume:
# nến rút râu phải có volume >= 1 lần trung bình. Khi test: 28 lệnh +11.7R, đảo giá + phí x2
# vẫn +13.9R, dữ liệu mới +5.7R — chạy dry-run để xác nhận.
MOMO_ENTRY_MODE=rejection
MOMO_VOL_MULT=1.0
# Profile volume 120 phút (2 giờ)
MOMO_VP_LOOKBACK=120
# Để trống = chạy 24 giờ (vàng có lọc volume lời cả phiên Á khi test)
MOMO_SESSIONS=
MOMO_TREND_FILTER=0
MOMO_VP_BIN=0.5
MOMO_ZONE_W=0.4
MOMO_FAST_MOVE=0.8

# Vàng chạy ~1/7 số điểm của NQ nên ngưỡng nhỏ hơn (điểm vàng, tick 0.1):
MOMO_MIN_5M_MOVE=2.0
MOMO_MIN_ATR_MULT=0.8
MOMO_MIN_1M_MOVE=1.2
MOMO_MIN_ATR5=1.2
MOMO_MIN_TP=1.5
MOMO_MAX_TP=7.0
MOMO_SCALP_TP=1.5
MOMO_MIN_SL=1.0
MOMO_MAX_SL=3.0
MOMO_SL_BUFFER=0.3
MOMO_TRAIL=1.2
MOMO_FADE_BODY=1.0
MOMO_MAX_HOLD_MIN=15
MOMO_TICK=0.1
MOMO_MAX_PER_CANDLE=1
