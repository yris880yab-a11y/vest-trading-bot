# ================= CẤU HÌNH TOPSTEP — gói 50K, micro Nasdaq =================
# Chỉ cần điền 2 dòng có <...> rồi lưu. Không để dấu cách quanh dấu =.

# --- Kết nối TopstepX ---
BOT_BROKER=topstep
TOPSTEP_USERNAME=<ten dang nhap TopstepX>
TOPSTEP_API_KEY=<API key>
# Tên tài khoản Combine (lấy từ lệnh kiểm tra). Bỏ trống nếu chỉ có 1 tài khoản.
TOPSTEP_ACCOUNT=
TOPSTEP_API_URL=https://api.topstepx.com

# --- Mã giao dịch: MNQ = micro Nasdaq, $2 mỗi điểm ---
BOT_STRATEGY=smc
BOT_SYMBOL=MNQ
BOT_CONFIRM_SYMBOL=MES
BOT_POINT_VALUE=2
BOT_SIZE_DECIMALS=0
BOT_MAX_CONTRACTS=50

# --- Rủi ro: $200 mỗi lệnh, dừng ngày khi lỗ 2 lệnh ---
BOT_RISK_USD=200
BOT_MAX_DAILY_LOSS_R=2
BOT_MAX_TRADES_PER_DAY=6
BOT_MIN_MOMENTUM=3

# --- Luật Topstep 50K ---
BOT_ACCOUNT_SIZE=50000
BOT_PROP_MAX_LOSS_USD=2000
BOT_PROP_TRAILING=eod
BOT_PROP_DAILY_LOSS_PCT=0
# Nếu lúc mua Combine có chọn Daily Loss Limit thì điền 1000:
BOT_PROP_DAILY_LOSS_USD=
BOT_PROP_SAFETY=0.75
# Combine: 3000. Khi đã lên Express Funded thì để trống.
BOT_PROFIT_TARGET_USD=3000
BOT_FLATTEN_TIME_CT=15:08
BOT_DAY_RESET=cme

# --- Chạy thử trước: true = không đặt lệnh thật ---
BOT_DRY_RUN=true
BOT_POLL_SECONDS=30
BOT_STATE_FILE=bot_state.json
