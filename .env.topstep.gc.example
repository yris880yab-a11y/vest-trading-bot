# ================= CẤU HÌNH TOPSTEP — VÀNG (MGC), chạy song song bot NQ =================
# Dùng CHUNG username / API key / tài khoản với bot NQ. Điền 2 dòng <...> rồi lưu.

# --- Kết nối TopstepX (giống file .env của bot NQ) ---
BOT_BROKER=topstep
TOPSTEP_USERNAME=<ten dang nhap TopstepX>
TOPSTEP_API_KEY=<API key>
TOPSTEP_ACCOUNT=
TOPSTEP_API_URL=https://api.topstepx.com

# --- Mã giao dịch: MGC = micro vàng, $10 mỗi điểm (0,1 điểm = $1) ---
BOT_STRATEGY=smc
BOT_SYMBOL=MGC
BOT_CONFIRM_SYMBOL=
BOT_POINT_VALUE=10
BOT_SIZE_DECIMALS=0
# 50K cho tối đa 50 micro TỔNG CỘNG: chia 25 cho GC, 25 cho NQ
BOT_MAX_CONTRACTS=25

# --- Rủi ro: $200 mỗi lệnh, dừng ngày khi bot GC lỗ 2 lệnh ---
BOT_RISK_USD=200
BOT_MAX_DAILY_LOSS_R=2
BOT_MAX_TRADES_PER_DAY=6
BOT_MIN_MOMENTUM=3

# --- Luật Topstep 50K (giống bot NQ; bot đọc số dư thật nên thấy cả lời/lỗ của bot NQ) ---
BOT_ACCOUNT_SIZE=50000
BOT_PROP_MAX_LOSS_USD=2000
BOT_PROP_TRAILING=eod
BOT_PROP_DAILY_LOSS_PCT=0
BOT_PROP_DAILY_LOSS_USD=
BOT_PROP_SAFETY=0.75
BOT_PROFIT_TARGET_USD=3000
BOT_FLATTEN_TIME_CT=15:08
BOT_DAY_RESET=cme

# --- File riêng của bot GC (không trùng với bot NQ) ---
BOT_STATE_FILE=bot_state_gc.json

# --- Chạy thử trước ---
BOT_DRY_RUN=true
BOT_POLL_SECONDS=30
