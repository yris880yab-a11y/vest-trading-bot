# ============ BOT TÍN HIỆU ORDER FLOW (kiểu Bookmap) — NQ / MNQ ============
# Chỉ BÁO TÍN HIỆU, không đặt lệnh. Dữ liệu L2 (sổ lệnh) + time & sales lấy từ TopstepX.
# Chạy: run_flow_signal.bat   hoặc   python -m vestbot.flow_signal
# Điền 2 dòng <...> rồi lưu thành .env.flow

TOPSTEP_USERNAME=<ten dang nhap TopstepX>
TOPSTEP_API_KEY=<API key>
TOPSTEP_API_URL=https://api.topstepx.com
# TOPSTEP_MARKET_HUB=wss://rtc.topstepx.com/hubs/market

# MNQ và NQ cùng sổ lệnh giá; NQ có size lệnh lớn hơn nhiều -> ngưỡng lot bên dưới tính theo NQ.
# Dùng MNQ thì giảm FLOW_BIG_TRADE / FLOW_WALL_MIN / FLOW_ABSORB_MIN_VOL / FLOW_DELTA_MIN.
FLOW_SYMBOL=NQ

# Nhắn Telegram mỗi tín hiệu (để trống = chỉ in ra màn hình)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ---- Ngưỡng (bỏ # để chỉnh). Đơn vị: lot, tick (0.25 điểm), giây, điểm ----
# FLOW_BIG_TRADE=30        # bubble: 1 lệnh market >= 30 lot (như "30 or more lot entries")
# FLOW_BUBBLE_WINDOW=30    # bubble còn tính là xác nhận trong 30 giây
# FLOW_WALL_MIN=40         # tường (vạch vàng heatmap): >= 40 lot ...
# FLOW_WALL_MULT=4         # ... và >= 4 lần size trung vị các mức giá quanh đó
# FLOW_WALL_RANGE=80       # tìm tường trong 80 tick (20 điểm) quanh giá
# FLOW_WALL_AGE=10         # tường phải đứng >= 10 giây mới tính (lọc spoof)
# FLOW_EAT_FRAC=0.5        # tường biến mất sau khi >= 50% size đã khớp = bị ĂN (breakout), không thì = bị RÚT
# FLOW_ABSORB_WINDOW=30    # absorption: trong 30 giây ...
# FLOW_ABSORB_MIN_VOL=150  # ... >= 150 lot market đánh vào 1 mức mà giá không xuyên qua
# FLOW_ABSORB_BAND=2       # +-2 tick quanh mức đó
# FLOW_TOUCH_TICKS=2       # cách tường <= 2 tick = chạm tường
# FLOW_TEST_MIN_VOL=30     # bật khỏi tường cần >= 30 lot market đánh vào tường trước đó
# FLOW_CONFIRM_TICKS=4     # giá phải bật >= 4 tick khỏi mức rồi mới báo
# FLOW_DELTA_WINDOW=60     # delta tính trong 60 giây
# FLOW_DELTA_MIN=100       # |delta| >= 100 lot cùng chiều = +1 điểm (ngược gấp đôi = -1)
# FLOW_IMB_LEVELS=10       # imbalance: tổng 10 mức bid / 10 mức ask ...
# FLOW_IMB_RATIO=2         # ... >= 2 lần = +1 điểm
# FLOW_MIN_SCORE=3         # trigger = 2 điểm, cần thêm >= 1 xác nhận
# FLOW_SL_BUFFER=6         # SL sau mức trigger 6 tick
# FLOW_MIN_SL=3            # SL tối thiểu 3 điểm
# FLOW_MAX_SL=15           # SL xa hơn 15 điểm = bỏ
# FLOW_RR=2                # TP = 2R nếu không có tường chắn
# FLOW_MIN_RR=1.2          # tường ngược chiều gần hơn 1.2R = bỏ
# FLOW_COOLDOWN=60         # mỗi chiều tối đa 1 tín hiệu / 60 giây
# FLOW_EVAL_EVERY=0.1       # kiểm tra tín hiệu tối đa 10 lần/giây (giảm tải khi tape dày)
